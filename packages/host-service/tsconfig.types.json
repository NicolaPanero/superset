{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"incremental": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"rootDir": "..",
		"outDir": "dist-types"
	},
	"include": ["src"],
	"exclude": [
		"node_modules",
		"dist",
		"dist-types",
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/*.node-test.ts"
	]
}
