{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "superset-realtime",
	"main": "src/index.ts",
	// Its own Worker rather than a class on the relay: every relay deploy drops
	// every host's control socket, and a change to how invalidations fan out
	// must never do that. realtime.superset.sh is what the apps bake in.
	"workers_dev": true,
	"routes": [{ "pattern": "realtime.superset.sh", "custom_domain": true }],
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_als"],
	"vars": {
		// Must match the API's JWT issuer/audience exactly, as on the relay.
		"NEXT_PUBLIC_API_URL": "https://api.superset.sh"
	},
	// NUDGE_SECRET is a secret (`wrangler secret put NUDGE_SECRET`); the API
	// sends it on every emit.
	"durable_objects": {
		"bindings": [
			{ "name": "OrgHub", "class_name": "OrgHub" },
			// One per page. Unlike OrgHub this one is a store, not a relay: a
			// page's storage records live in its SQLite and nowhere else.
			{ "name": "PageHub", "class_name": "PageHub" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["OrgHub"] },
		{ "tag": "v2", "new_sqlite_classes": ["PageHub"] }
	],
	"observability": { "enabled": true }
}
